machine foo
{
	event e1;
	state s1 implemented by machine bar, s2;

	machine bar
	{
		event parent::e1, e2;
		state s1, s2;

		action a1[e1,s1] transition s2;
		action a2[e1,s2];
		action a3[e2, (s1, s2)] transition s1;
	}

	machine bar
	{
		event parent::e1, e2;
		state s1, s2;

		action a1[e1,s1] transition s2;
		action a2[e1,s2];
		action a3[e2, (s1, s2)] transition s1;
	}

	machine baz
	{
		event parent::e1, e2;
		state s1, s2;

		action a1[e1,s1] transition s2;
		action a2[e1,s2];
		action a3[e2, (s1, s2)] transition s1;
	}

	transition [e1, s1] s2;
	action a1[e1, s2];
}

