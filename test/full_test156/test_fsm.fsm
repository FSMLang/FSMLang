native
{
#include <stdio.h>
#define DBG_PRINTF(...) printf(__VA_ARGS__); printf("\n");
}

machine test_fsm
native impl
{
	#define INIT_FSM_DATA { .i = 0, .j = 0, .k = 0, .l = 0, .pe1_data = NULL }
}
{
	data
	{
		int i;
		int j;
		int k;
		int l;
		pTEST_FSM_E1_DATA pe1_data;
	}

	event e0;
	event e1 data translator xlate_e1 implemented by machine e1_translator {int i;};
	event e2;

	state s1;
	state s2 implemented by machine s2_implementor
				on entry init_s2_implementor
				;

	machine e1_translator
		actions return void;
		native impl
		{
			#define INIT_FSM_DATA { .pparent_data = NULL}
		}
	{
		data
		{
			pTEST_FSM_DATA pparent_data;
		}
		event parent::e0;
		event parent::e1 data translator grab_data;
		state s1, s2, s3, s4;

		action a0[e0, s1];
		action a1[e1, s1] transition s2;
		action a2[e1, s2] transition s3;
		action a3[e1, s3] transition s4;
		action a4[e1, s4] transition s1;
	}

	machine s2_implementor
	{
		event parent::e0;
		event parent::e1;
		event parent::e2;

		state s1;
		state s2;

		transition [e0, s1] s2;

		action a1 [e1, s2];
		action a2 [e2, s2];
	}


	action a0[e0, s1];
	action a1[e1, s1];
	transition [e2, s1] s2;

}
