native
{
#include <stdio.h>
#define DBG_PRINTF(...) printf(__VA_ARGS__); printf("\n");
}

machine test_fsm
	data translators return events;
native impl
{
	#define INIT_FSM_DATA { .i = 0, .j = 0, .k = 0, .l = 0 }
}
{
	data
	{
		int i;
		int j;
		int k;
		int l;
	}

	event e0;
	event e1 consuming data translator implemented by machine e1_e2_translator {int i;};
	event e2 consuming data translator implemented by machine e1_e2_translator {int i;};
	event data_updated;
	state s1;

	machine e1_e2_translator
		native impl
		{
			#define INIT_FSM_DATA { .pparent_data = NULL, .event_value = 0 }
		}
	{
		data
		{
			pTEST_FSM_DATA pparent_data;
			int event_value;
		}
		event parent::e0;
		event parent::e1 data translator grab_e1_data;
		event parent::e2 data translator grab_e2_data;
		state s1, s2, s3, s4;

		action a0[e0, s1];
		action a1[(e1 ,e2), s1] transition s2;
		action a2[(e1 ,e2), s2] transition s3;
		action a3[(e1 ,e2), s3] transition s4;
		action a4[(e1 ,e2), s4] transition s1;
	}

	action a0[e0, s1];
	action a1[data_updated, s1];

}
