/**
	This sub-machine parses incomming commands.

	Legal commands:
	
	0: peer id           : 4 ASCII NUMERIC bytes
	1: peer ble addr type: 1 uint8_t
	2: peer ble addr     : uint8_t[6]

	When the ble addr data and the peer id has been received,
	the parent::connect event is returned.  When the peer id is received
	first, the parent::scan event is returned.
*/
native
{
#include "command_defs.h"
}

machine commands
native impl
{
#define INIT_FSM_DATA {NULL,0,0,{{0}},{{0}},{{0}}}
}

{
data
{
pcommand_str  *ppcommand;
uint8_t       cmd_bits;
uint8_t       peer_ble_addr_type;
ble_addr_str  peer_ble_addr;
sn_str        peer_sn;
id_str        peer_id;
}

	state initial
			on entry set_defaults
			;
	state waiting_pairing_info;
	state pairing_info_found;

	event parent::activate data translator grab_command_ptr;
	event parent::command;

	transition [activate, initial] waiting_pairing_info;
	transition [activate, (waiting_pairing_info, pairing_info_found)] initial;

	action parse_command [command, waiting_pairing_info] transition check_pairing_info;
}
