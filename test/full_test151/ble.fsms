/**
	This machine handles all ble work.

	When only the id of the peer device is known, we must scan for it.

	When the ble address information and the next expected communications window are known,
	a more targeted search can be done.
*/
machine ble
	data translators return events;
{
	data
	{
		pconfiguration_str pconfiguration;
		pble_event_str     *ppcurr_ble_event;
	}

	event parent::activate data translator grab_parent_data_ptrs;
	event parent::ble_comm consuming data translator translate_ble_comm;
	event parent::configuration_complete consuming data translator check_configuration;

	event do_scan;
	event do_connect;
	event adv_packet;
	event gatt_msg;
	event disconnection;
	event connection;

	state initial;
	state waiting
			on entry set_defaults
			;
	state scanning
			on entry start_scanning
			on exit  stop_scanning
         ;

	state waiting_for_connection_window
			on entry start_connection_timer
			on exit  stop_connection_timer
			;

	transition [activate, (all)] waiting;
	transition [do_scan, waiting] scanning;
	transition [do_connect, waiting] waiting_for_connection_window;

	action parse_adv_packet[adv_packet, scanning];
	action report_connection [connection, scanning] transition waiting;
}

