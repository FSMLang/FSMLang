/**
	This machine handles the auth2 chores.
*/
machine auth2
native impl
{
#define FSM_ENTRY(A)
#define FSM_EXIT(A) DBG_PRINTF("auth2: end state: %s", AUTH2_STATE_NAMES[(A)->state])
#define ACTION_ENTRY(A)
#define ACTION_EXIT(A)
}
{
	state initial;
	state active;
	state step1;
	state step2;
	state done;

	event parent::activate;
	event parent::start_auth2;
	event parent::auth2_gatt;
	event parent::comm_window_starting;

	transition [activate, (all)] active;
	transition [comm_window_starting, done] active;

	action send_step1[start_auth2, active] transition step1;
	action send_step2[auth2_gatt, step1] transition step2;
	action report_auth2_complete[auth2_gatt, step2] transition done;

}

