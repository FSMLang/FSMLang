
test: scan_happy_path
!test input: [e.event = THIS(activate)]
communicator[0]: event: activate; state: initial
communicator_activate_all
commands[0]: event: activate; state: initial
communicator_commands_noAction
commands: end state: waiting_pairing_info
communicator_ble_grab_parent_data_ptrs
ble[0]: event: activate; state: initial
communicator_ble_noAction
communicator_ble_set_defaults
ble: end state: waiting
auth1[0]: event: activate; state: initial
communicator_auth1_noAction
auth1: end state: active
auth2[0]: event: activate; state: initial
communicator_auth2_noAction
auth2: end state: active
sync[0]: event: activate; state: initial
communicator_sync_noAction
sync: end state: active
communicator_set_defaults
communicator: end state: waiting
!test input: [e.event = THIS(command)]
!test input: [e.event_data.command_data.command.tag = command_peer_id]
communicator_grab_command
commands[0]: event: command; state: waiting_pairing_info
communicator_commands_parse_command
peer_id: [5678]
peer_sn: []
peer_ble_addr: []
peer_ble_addr_type: [0]
next_peer_comm_window: [0]
peer_comm_period: [0]
config_bits: [ peer_id ]
communicator_commands_check_pairing_info
commands: end state: waiting_pairing_info
communicator: end state: waiting
!test input: [e.event_data.command_data.command.tag = command_peer_sn]
communicator_grab_command
commands[0]: event: command; state: waiting_pairing_info
communicator_commands_parse_command
peer_id: [5678]
peer_sn: [012345678901]
peer_ble_addr: []
peer_ble_addr_type: [0]
next_peer_comm_window: [0]
peer_comm_period: [0]
config_bits: [ peer_id peer_sn ]
communicator_commands_check_pairing_info
commands: end state: pairing_info_found
communicator[0]: event: configuration_complete; state: waiting
communicator_start_looking
communicator_ble_check_configuration
ble[0]: event: do_scan; state: waiting
communicator_ble_noAction
communicator_ble_start_scanning
ble: end state: scanning
first_connection[0]: event: activate; state: initial
communicator_first_connection_noAction
first_connection: end state: waiting
communicator: end state: first_time_connect
!test input: [e.event = THIS(ble_comm)]
!test input: [e.event_data.ble_comm_data.ble_e.type = ble_adv_packet]
communicator_grab_ble_comm
communicator_ble_translate_ble_comm
ble[0]: event: adv_packet; state: scanning
communicator_ble_parse_adv_packet
ble[0]: event: connection; state: scanning
communicator_ble_report_connection
communicator_ble_stop_scanning
communicator_ble_start_connection_timer
ble: end state: waiting_for_connection_window
communicator[0]: event: peer_connected; state: first_time_connect
first_connection[0]: event: peer_connected; state: waiting
communicator_first_connection_act_start_auth1
auth1[0]: event: start_auth1; state: active
communicator_auth1_send_step1
auth1: end state: step1
first_connection: end state: auth1
communicator: end state: first_time_connect
!test input: [e.event = THIS(ble_comm)]
!test input: [e.event_data.ble_comm_data.ble_e.type = ble_gatt_message]
!test input: [e.event_data.ble_comm_data.ble_e.data.gatt_msg.characteristic = AUTH1_GATT]
communicator_grab_ble_comm
communicator_ble_translate_ble_comm
ble[0]: event: gatt_msg; state: waiting_for_connection_window
communicator_ble_report_gatt_characteristic
ble: end state: waiting_for_connection_window
communicator[0]: event: auth1_gatt; state: first_time_connect
first_connection[0]: event: auth1_gatt; state: auth1
communicator_first_connection_share_parent_auth1_gatt
auth1[0]: event: auth1_gatt; state: step1
communicator_auth1_send_step2
auth1: end state: step2
first_connection: end state: auth1
communicator: end state: first_time_connect
