auth1[0]: event: auth1_gatt; state: step2
communicator_auth1_report_auth1_complete
auth1: end state: done
first_connection: end state: auth1
communicator[0]: event: auth1_complete; state: first_time_connect
first_connection[0]: event: auth1_complete; state: auth1
