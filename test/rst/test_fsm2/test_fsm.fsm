native
{
#include <stdio.h>
#define DBG_PRINTF(...) printf(__VA_ARGS__); printf("\n");
}

machine test_fsm
	data translators return events;
native impl
{
	#define INIT_FSM_DATA { .i = 0, .j = 0, .k = 0, .l = 0 }
}
{
	data
	{
		int i;
		int j;
		int k;
		int l;
	}

	event e0;
	event e1 consuming data translator xlate_e1 implemented by machine e1_translator {int i;};
	event data_updated;
	state s1;

	machine e1_translator
		data translators return events;
		native impl
		{
			#define INIT_FSM_DATA { .pparent_data = NULL, .event_value = 0 }
		}
	{
		data
		{
			pTEST_FSM_DATA pparent_data;
			int event_value;
		}
		event parent::e0 consuming data translator grab_parent_data_pointer;
		event parent::e1 consuming data translator grab_e1_data;
		event data_arrived;
		state s1, s2, s3, s4;

		action a1[data_arrived, s1] transition s2;
		action a2[data_arrived, s2] transition s3;
		action a3[data_arrived, s3] transition s4;
		action a4[data_arrived, s4] transition s1;
	}

	action a0[e0, s1];
	action a1[data_updated, s1];

	xlate_e1 returns
		data_updated
		, noEvent
		;
}
